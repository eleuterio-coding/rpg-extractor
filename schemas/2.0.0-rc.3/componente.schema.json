{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "record": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "system": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "publication": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "adapter",
        "system",
        "edition",
        "publication"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "pointer": {
          "type": "string",
          "minLength": 1
        },
        "sourceSha": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "repo",
        "commit",
        "path",
        "pointer",
        "sourceSha"
      ],
      "additionalProperties": false
    },
    "kind": {
      "enum": [
        "ataque_variante_materializada",
        "custo_conjuracao_pf2e"
      ]
    },
    "raw": {},
    "limits": {
      "type": "string",
      "minLength": 1
    },
    "bloquear_importacao": {
      "const": true
    }
  },
  "required": [
    "id",
    "record",
    "scope",
    "evidence",
    "kind",
    "raw",
    "limits",
    "bloquear_importacao"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eleuterio-coding.github.io/rpg-extractor/schemas/2.0.0-rc.3/componente.schema.json"
}
