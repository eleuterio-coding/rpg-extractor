{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eleuterio-coding.github.io/rpg-extractor/schemas/1.5.0/expressao.schema.json",
  "title": "expressao — contrato semântico provisório",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schemaVersion",
    "evidence",
    "partition",
    "module",
    "bloquear_importacao",
    "tag",
    "raw",
    "offset",
    "ast",
    "automation",
    "reason",
    "inputContract",
    "outputContract"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": "1.5.0"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "path",
        "pointer",
        "source",
        "sourceSha",
        "commit"
      ],
      "properties": {
        "record": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "pointer": {
          "type": "string",
          "pattern": "^(?:/.*)?$"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "sourceSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "partition": {
      "enum": [
        "principal",
        "dependencia",
        "documento",
        "auxiliar"
      ]
    },
    "module": {
      "enum": [
        null,
        "M01",
        "M02",
        "M03",
        "M04",
        "M05",
        "M06",
        "M07",
        "M08",
        "M09",
        "M10"
      ]
    },
    "bloquear_importacao": {
      "const": true
    },
    "tag": {
      "type": "string",
      "minLength": 1
    },
    "raw": {
      "type": "string",
      "minLength": 1
    },
    "offset": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "ast": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "terms",
            "variables"
          ],
          "properties": {
            "op": {
              "const": "sum"
            },
            "terms": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "sign",
                      "value"
                    ],
                    "properties": {
                      "kind": {
                        "const": "constant"
                      },
                      "sign": {
                        "enum": [
                          -1,
                          1
                        ]
                      },
                      "value": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "sign",
                      "count",
                      "sides"
                    ],
                    "properties": {
                      "kind": {
                        "const": "dice"
                      },
                      "sign": {
                        "enum": [
                          -1,
                          1
                        ]
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      },
                      "sides": {
                        "type": "integer",
                        "minimum": 2,
                        "maximum": 1000
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "sign",
                      "name"
                    ],
                    "properties": {
                      "kind": {
                        "const": "variable"
                      },
                      "sign": {
                        "enum": [
                          -1,
                          1
                        ]
                      },
                      "name": {
                        "const": "summonSpellLevel"
                      }
                    }
                  }
                ]
              }
            },
            "variables": {
              "type": "array",
              "items": {
                "const": "summonSpellLevel"
              },
              "uniqueItems": true
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "automation": {
      "enum": [
        "consultiva",
        "componente_executavel_isolado"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "inputContract": {
      "oneOf": [
        {
          "const": "rolls_e_variaveis_v1"
        },
        {
          "type": "null"
        }
      ]
    },
    "outputContract": {
      "oneOf": [
        {
          "const": "valor_e_rolagens_v1"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
