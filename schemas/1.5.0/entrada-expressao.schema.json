{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rolls",
    "variables"
  ],
  "properties": {
    "rolls": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000
      }
    },
    "variables": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summonSpellLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    }
  }
}
