{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eleuterio-coding.github.io/rpg-extractor/schemas/1.8.0/identidade.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "localId": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "adapter": {
          "enum": [
            "dnd5e-5etools",
            "pf2e-foundry"
          ]
        },
        "system": {
          "enum": [
            "dnd5e",
            "pf2e"
          ]
        },
        "edition": {
          "enum": [
            "5e-2024-revisada",
            "remaster",
            "legacy",
            "nao_confirmada"
          ]
        },
        "publication": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "adapter",
        "system",
        "edition",
        "publication"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "pointer": {
          "type": "string",
          "pattern": "^(?:/.*)?$"
        },
        "sourceSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      },
      "required": [
        "repo",
        "commit",
        "path",
        "pointer",
        "sourceSha"
      ],
      "additionalProperties": false
    },
    "nativeType": {
      "type": "string",
      "minLength": 1
    },
    "partition": {
      "enum": [
        "principal",
        "dependencia",
        "auxiliar"
      ]
    },
    "editionEvidence": {
      "type": "string",
      "minLength": 1
    },
    "automation": {
      "const": "consultiva"
    },
    "bloquear_importacao": {
      "const": true
    }
  },
  "required": [
    "id",
    "localId",
    "scope",
    "evidence",
    "nativeType",
    "partition",
    "editionEvidence",
    "automation",
    "bloquear_importacao"
  ],
  "additionalProperties": false
}
