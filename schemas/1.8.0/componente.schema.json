{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eleuterio-coding.github.io/rpg-extractor/schemas/1.8.0/componente.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "recordId": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "adapter": {
          "enum": [
            "dnd5e-5etools",
            "pf2e-foundry"
          ]
        },
        "system": {
          "enum": [
            "dnd5e",
            "pf2e"
          ]
        },
        "edition": {
          "enum": [
            "5e-2024-revisada",
            "remaster",
            "legacy",
            "nao_confirmada"
          ]
        },
        "publication": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "adapter",
        "system",
        "edition",
        "publication"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "pointer": {
          "type": "string",
          "pattern": "^(?:/.*)?$"
        },
        "sourceSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      },
      "required": [
        "repo",
        "commit",
        "path",
        "pointer",
        "sourceSha"
      ],
      "additionalProperties": false
    },
    "params": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "multiplicador_forca"
            },
            "multiplier": {
              "enum": [
                7.5,
                15,
                30,
                60,
                120,
                240
              ]
            }
          },
          "required": [
            "kind",
            "multiplier"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "custo_acao_pf2e"
            },
            "cost": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            }
          },
          "required": [
            "kind",
            "cost"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "dados_fixos_pf2e"
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "sides": {
              "type": "integer",
              "minimum": 2,
              "maximum": 1000
            },
            "modifier": {
              "type": "integer",
              "minimum": -1000000,
              "maximum": 1000000
            }
          },
          "required": [
            "kind",
            "count",
            "sides",
            "modifier"
          ],
          "additionalProperties": false
        }
      ]
    },
    "raw": {},
    "limits": {
      "type": "string",
      "minLength": 1
    },
    "automation": {
      "const": "componente_executavel_isolado"
    },
    "bloquear_importacao": {
      "const": true
    }
  },
  "required": [
    "id",
    "recordId",
    "scope",
    "evidence",
    "params",
    "raw",
    "limits",
    "automation",
    "bloquear_importacao"
  ],
  "additionalProperties": false
}
