{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eleuterio-coding.github.io/rpg-extractor/schemas/1.8.0/componente.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "recordId": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "system": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "publication": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "adapter",
        "system",
        "edition",
        "publication"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "pointer": {
          "type": "string",
          "pattern": "^(?:/.*)?$"
        },
        "sourceSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      },
      "required": [
        "repo",
        "commit",
        "path",
        "pointer",
        "sourceSha"
      ],
      "additionalProperties": false
    },
    "params": {
      "type": "object"
    },
    "raw": {},
    "limits": {
      "type": "string",
      "minLength": 1
    },
    "automation": {
      "const": "componente_executavel_isolado"
    },
    "bloquear_importacao": {
      "const": true
    }
  },
  "required": [
    "id",
    "recordId",
    "scope",
    "evidence",
    "params",
    "raw",
    "limits",
    "automation",
    "bloquear_importacao"
  ],
  "additionalProperties": false
}
