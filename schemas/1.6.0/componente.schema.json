{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eleuterio-coding.github.io/rpg-extractor/schemas/1.6.0/componente.schema.json",
  "title": "componente — contrato experimental",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "semanticId": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "pointer": {
          "type": "string",
          "pattern": "^(?:/.*)?$"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "sourceSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      },
      "required": [
        "record",
        "path",
        "pointer",
        "source",
        "sourceSha",
        "commit"
      ]
    },
    "raw": {
      "type": "string",
      "minLength": 1
    },
    "tag": {
      "type": "string",
      "minLength": 1
    },
    "ast": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "1.6.0"
        },
        "nodes": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "op": {
                    "const": "const"
                  },
                  "value": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000000
                  }
                },
                "required": [
                  "op",
                  "value"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "op": {
                    "const": "var"
                  },
                  "name": {
                    "const": "summonSpellLevel"
                  }
                },
                "required": [
                  "op",
                  "name"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "op": {
                    "const": "dice"
                  },
                  "sides": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 1000
                  }
                },
                "required": [
                  "op",
                  "sides"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "op": {
                    "enum": [
                      "neg",
                      "floor",
                      "ceil",
                      "add",
                      "sub",
                      "mul",
                      "div"
                    ]
                  }
                },
                "required": [
                  "op"
                ]
              }
            ]
          },
          "maxItems": 96,
          "minItems": 1
        },
        "variables": {
          "type": "array",
          "items": {
            "const": "summonSpellLevel"
          },
          "maxItems": 1,
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "version",
        "nodes",
        "variables"
      ]
    },
    "inputContract": {
      "const": "entrada"
    },
    "outputContract": {
      "const": "saida"
    },
    "automation": {
      "const": "componente_executavel_isolado"
    },
    "bloquear_importacao": {
      "const": true
    }
  },
  "required": [
    "id",
    "semanticId",
    "evidence",
    "raw",
    "tag",
    "ast",
    "inputContract",
    "outputContract",
    "automation",
    "bloquear_importacao"
  ]
}
