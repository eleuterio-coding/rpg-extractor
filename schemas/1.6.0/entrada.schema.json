{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eleuterio-coding.github.io/rpg-extractor/schemas/1.6.0/entrada.schema.json",
  "title": "entrada — contrato experimental",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "rolls": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000
      },
      "maxItems": 100,
      "minItems": 0
    },
    "variables": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summonSpellLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        }
      },
      "required": []
    }
  },
  "required": [
    "rolls",
    "variables"
  ]
}
