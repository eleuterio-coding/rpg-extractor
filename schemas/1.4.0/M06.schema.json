{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eleuterio-coding.github.io/rpg-extractor/schemas/1.4.0/M06.schema.json",
  "title": "Equipamentos — provisório",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "module",
    "name",
    "publication",
    "commit",
    "state",
    "records",
    "dependencies",
    "documentViews",
    "bloquear_importacao"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.4.0"
    },
    "module": {
      "const": "M06"
    },
    "name": {
      "const": "Equipamentos"
    },
    "publication": {
      "type": "string",
      "minLength": 1
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "state": {
      "const": "candidato_nao_homologado"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "pointer",
          "category",
          "source",
          "sourceSha",
          "data"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "pointer": {
            "type": "string",
            "pattern": "^/"
          },
          "category": {
            "enum": [
              "item",
              "baseitem",
              "itemGroup",
              "itemProperty",
              "itemType",
              "itemTypeAdditionalEntries",
              "itemMastery"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "sourceSha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "data": {
            "type": "object"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "pointer",
          "category",
          "source",
          "sourceSha",
          "data"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "pointer": {
            "type": "string",
            "pattern": "^/"
          },
          "category": {
            "enum": [
              "item",
              "baseitem",
              "itemGroup",
              "itemProperty",
              "itemType",
              "itemTypeAdditionalEntries",
              "itemMastery"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "sourceSha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "data": {
            "type": "object"
          }
        }
      }
    },
    "documentViews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record",
          "path",
          "pointer",
          "sourceSha",
          "name",
          "type"
        ],
        "properties": {
          "record": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "pointer": {
            "type": "string",
            "pattern": "^/"
          },
          "sourceSha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "section",
              "entries"
            ]
          }
        }
      }
    },
    "bloquear_importacao": {
      "const": true
    }
  }
}
