{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eleuterio-coding.github.io/rpg-extractor/schemas/1.9.0/snapshot.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.9.0"
    },
    "contractId": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "system": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "publication": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "adapter",
        "system",
        "edition",
        "publication"
      ],
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "registro_consultivo",
              "componente_isolado"
            ]
          },
          "scope": {
            "type": "object",
            "properties": {
              "adapter": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,63}$"
              },
              "system": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,63}$"
              },
              "edition": {
                "type": "string",
                "minLength": 1
              },
              "publication": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "adapter",
              "system",
              "edition",
              "publication"
            ],
            "additionalProperties": false
          },
          "payloadSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sourceId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "scope",
          "payloadSha256",
          "sourceId"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "contractId",
    "scope",
    "items"
  ],
  "additionalProperties": false
}
