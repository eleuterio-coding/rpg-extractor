{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eleuterio-coding.github.io/rpg-extractor/schemas/1.9.0/relatorio.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.9.0"
    },
    "scope": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "system": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "publication": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "adapter",
        "system",
        "edition",
        "publication"
      ],
      "additionalProperties": false
    },
    "records": {
      "type": "integer",
      "minimum": 0
    },
    "components": {
      "type": "integer",
      "minimum": 0
    },
    "passedComponents": {
      "type": "integer",
      "minimum": 0
    },
    "blockedComponents": {
      "type": "integer",
      "minimum": 0
    },
    "sourcePending": {
      "type": "integer",
      "minimum": 0
    },
    "sourceFailures": {
      "type": "integer",
      "minimum": 0
    },
    "releaseIntegrity": {
      "enum": [
        "conferida",
        "divergente",
        "nao_conferida"
      ]
    },
    "reviewStatus": {
      "enum": [
        "aprovado_no_escopo_testado",
        "bloqueado"
      ]
    },
    "official": {
      "const": false
    },
    "integration": {
      "const": "bloqueada"
    },
    "bloquear_importacao": {
      "const": true
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "version",
    "scope",
    "records",
    "components",
    "passedComponents",
    "blockedComponents",
    "sourcePending",
    "sourceFailures",
    "releaseIntegrity",
    "reviewStatus",
    "official",
    "integration",
    "bloquear_importacao",
    "limits"
  ],
  "additionalProperties": false
}
