{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eleuterio-coding.github.io/rpg-extractor/schemas/1.9.0/contrato.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": "1.9.0"
    },
    "scope": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "system": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "publication": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "adapter",
        "system",
        "edition",
        "publication"
      ],
      "additionalProperties": false
    },
    "official": {
      "const": false
    },
    "mode": {
      "const": "simulacao_local"
    },
    "allowedKinds": {
      "type": "array",
      "items": {
        "enum": [
          "registro_consultivo",
          "componente_isolado"
        ]
      },
      "uniqueItems": true
    },
    "bloquear_importacao": {
      "const": true
    }
  },
  "required": [
    "id",
    "version",
    "scope",
    "official",
    "mode",
    "allowedKinds",
    "bloquear_importacao"
  ],
  "additionalProperties": false
}
