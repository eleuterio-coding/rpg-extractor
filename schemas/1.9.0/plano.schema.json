{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eleuterio-coding.github.io/rpg-extractor/schemas/1.9.0/plano.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.9.0"
    },
    "contractId": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "system": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "publication": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "adapter",
        "system",
        "edition",
        "publication"
      ],
      "additionalProperties": false
    },
    "mode": {
      "const": "simulacao_local"
    },
    "official": {
      "const": false
    },
    "snapshotOrigin": {
      "enum": [
        "vazio_declarado",
        "arquivo_local"
      ]
    },
    "counts": {
      "type": "object",
      "properties": {
        "create": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged": {
          "type": "integer",
          "minimum": 0
        },
        "conflict": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "create",
        "unchanged",
        "conflict",
        "blocked"
      ],
      "additionalProperties": false
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidate": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "registro_consultivo",
                  "componente_isolado"
                ]
              },
              "scope": {
                "type": "object",
                "properties": {
                  "adapter": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{1,63}$"
                  },
                  "system": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{1,63}$"
                  },
                  "edition": {
                    "type": "string",
                    "minLength": 1
                  },
                  "publication": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "adapter",
                  "system",
                  "edition",
                  "publication"
                ],
                "additionalProperties": false
              },
              "payloadSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "sourceId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "kind",
              "scope",
              "payloadSha256",
              "sourceId"
            ],
            "additionalProperties": false
          },
          "operation": {
            "enum": [
              "criar_simulado",
              "inalterado",
              "conflito",
              "bloqueado"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "existingSha256": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "candidate",
          "operation",
          "reason",
          "existingSha256"
        ],
        "additionalProperties": false
      }
    },
    "status": {
      "enum": [
        "simulacao_sem_conflitos",
        "bloqueado"
      ]
    },
    "rollbackCandidates": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "bloquear_importacao": {
      "const": true
    }
  },
  "required": [
    "version",
    "contractId",
    "scope",
    "mode",
    "official",
    "snapshotOrigin",
    "counts",
    "operations",
    "status",
    "rollbackCandidates",
    "errors",
    "bloquear_importacao"
  ],
  "additionalProperties": false
}
